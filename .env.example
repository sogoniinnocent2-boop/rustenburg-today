# Local application data. Production uses the same SQLite file layout on one Node process.
# SQLite database: $DATA_DIR/rustenburg.db
# Uploads: $DATA_DIR/uploads
# Railway production mounts a persistent volume at /data and sets DATA_DIR=/data.
# Keep a single application replica when using SQLite on that volume.
DATA_DIR=./data

# Required in production. A long random string.
SESSION_SECRET=

# Public site URL (no trailing slash). Used for OAuth callbacks and absolute links.
# Production example: https://www.rustenburgtoday.co.za
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed platform configuration and one labelled demonstration story. Never seeds fake jobs,
# crimes, medical providers, missing people, or traffic incidents.
SEED_DEMO=true

# Optional first administrator. If omitted, a random password is written to
# data/bootstrap-admin.txt on first boot (development only).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transactional email. Without these, messages stay in the email outbox.
# cPanel SSL/TLS example: host mail.example.co.za, port 465 (implicit TLS).
# Port 587 uses STARTTLS. Authentication is required.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rustenburg Today <noreply@example.co.za>

# Off-site backups. This must be a directory on a different disk from DATA_DIR.
# npm run backup fails when this is empty, missing, or on the same disk.
# Local copies in $DATA_DIR/backups are kept for 7 days. Off-site copies are kept for 30 days.
BACKUP_OFFSITE_DIR=

# Payment provider. Orders are never marked paid from the browser.
# PayFast is the prepared South African provider. Leave these blank until a sandbox
# payment succeeds. Naming the provider does not enable payments.
# Webhooks must be signed with PAYMENT_WEBHOOK_SECRET (HMAC-SHA256, hex, header x-payment-signature).
PAYMENT_PROVIDER=none
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYMENT_WEBHOOK_SECRET=

# Web Push. In-app and email alerts work without these. Push delivery stays queued until set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@rustenburg.today

# Sign-in providers. Leave blank until the provider app exists.
# See docs/OAUTH_SETUP.md. Callbacks must be NEXT_PUBLIC_SITE_URL plus the path below.
# Do not invent credentials or commit secrets.
# Google:  /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override; defaults to {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# GOOGLE_CALLBACK_URL=
# Apple Sign in with Apple. The private key is the .p8 contents, with newlines written as \n.
# Apple:   /api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Facebook Login. Facebook only returns an email when the person grants the email permission.
# Facebook: /api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional explicit override; defaults to {NEXT_PUBLIC_SITE_URL}/api/auth/facebook/callback
# FACEBOOK_CALLBACK_URL=

# Optional AI provider. The assistant stays off until a live model test passes, even if these are set.
# Requests are limited to 20 a day for a signed-in person. The log stores the length and the outcome, not the text.
AI_PROVIDER=
AI_API_KEY=
